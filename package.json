{
	"name": "testinteractivos",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"scripts": {
		"dev": "vite",
		"build": "tsc -p tsconfig.build.json && vite build",
		"build:web": "npm run build",
		"lint": "eslint .",
		"preview": "vite preview",
		"cap:sync": "npm run build && npx cap sync android",
		"android:sync": "npm run cap:sync",
		"android:assets": "npx capacitor-assets generate --android",
		"android:open": "npx cap open android",
		"android:apk": "npm run cap:sync && cd android && ./gradlew assembleDebug",
		"android:apk:release": "npm run cap:sync && cd android && ./gradlew assembleRelease",
		"android:aab": "npm run cap:sync && cd android && ./gradlew bundleRelease",
		"android:verify": "npm run android:apk && npm run android:apk:release && npm run android:aab",
		"prepare": "husky install",
		"commit": "npx git-cz",
		"test": "vitest run",
		"test:ui": "vitest --ui",
		"test:unit": "vitest run",
		"test:cov": "vitest run --coverage",
		"test:e2e": "playwright test --project=chromium",
		"test:e2e:cov": "COVERAGE=1 playwright test && playwright-coverage merge && playwright-coverage report",
		"test:coverage": "istanbul report --root coverage --dir coverage/html",
		"import:devops": "node src/utils/importDevopsQuestions.cjs",
		"db:normalize-categories": "node src/utils/normalizeCategoryCasing.cjs",
		"db:challenges-seed": "node scripts/generate-challenges-seed.mjs"
	},
	"dependencies": {
		"@capacitor/android": "^8.4.0",
		"@capacitor/app": "^8.1.0",
		"@capacitor/browser": "^8.0.3",
		"@capacitor/core": "^8.4.0",
		"@capacitor/haptics": "^8.0.2",
		"@capacitor/splash-screen": "^8.0.1",
		"@fontsource-variable/inter": "^5.3.0",
		"@fontsource-variable/jetbrains-mono": "^5.3.0",
		"@fontsource-variable/space-grotesk": "^5.3.0",
		"@marsidev/react-turnstile": "^1.6.3",
		"@radix-ui/react-slot": "^1.2.3",
		"@shikijs/langs": "^4.5.0",
		"@shikijs/themes": "^4.5.0",
		"@supabase/auth-ui-react": "^0.4.7",
		"@supabase/auth-ui-shared": "^0.1.8",
		"@supabase/supabase-js": "^2.100.1",
		"acorn": "^8.19.0",
		"axios": "^1.9.0",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"framer-motion": "^12.16.0",
		"lucide-react": "^0.515.0",
		"prismjs": "^1.30.0",
		"react": "^19.1.0",
		"react-dom": "^19.1.0",
		"react-hot-toast": "^2.5.2",
		"react-router-dom": "^7.6.2",
		"react-simple-code-editor": "^0.14.1",
		"recharts": "^2.15.3",
		"shiki": "^4.5.0",
		"tailwind-merge": "^3.3.1",
		"tailwindcss-animate": "^1.0.7",
		"zustand": "^5.0.5"
	},
	"devDependencies": {
		"@bgotink/playwright-coverage": "^0.3.2",
		"@capacitor/assets": "^3.0.5",
		"@capacitor/cli": "^8.4.0",
		"@commitlint/cli": "^19.8.1",
		"@commitlint/config-conventional": "^19.8.1",
		"@electric-sql/pglite": "^0.5.13",
		"@eslint/js": "^9.25.0",
		"@playwright/test": "^1.52.0",
		"@testing-library/jest-dom": "^6.6.3",
		"@testing-library/react": "^16.3.0",
		"@testing-library/user-event": "^14.6.1",
		"@types/lodash": "^4.17.17",
		"@types/prismjs": "^1.26.5",
		"@types/react": "^19.1.2",
		"@types/react-dom": "^19.1.2",
		"@types/react-router-dom": "^5.3.3",
		"@types/recharts": "^1.8.29",
		"@vitejs/plugin-react": "^4.4.1",
		"@vitest/coverage-v8": "^3.2.3",
		"@vitest/ui": "^3.2.3",
		"autoprefixer": "^10.4.21",
		"axe-core": "^4.14.0",
		"commitlint": "^19.8.1",
		"dotenv": "^17.3.1",
		"eslint": "^9.25.0",
		"eslint-plugin-react-hooks": "^5.2.0",
		"eslint-plugin-react-refresh": "^0.4.19",
		"globals": "^16.0.0",
		"husky": "^8.0.0",
		"istanbul-lib-coverage": "^3.2.2",
		"istanbul-lib-report": "^3.0.1",
		"istanbul-reports": "^3.1.7",
		"jsdom": "^26.1.0",
		"lint-staged": "^16.1.0",
		"playwright": "^1.52.0",
		"pngjs": "^7.0.0",
		"postcss": "^8.5.4",
		"tailwindcss": "^3.4.1",
		"typescript": "~5.8.3",
		"typescript-eslint": "^8.30.1",
		"vite": "^6.3.5",
		"vite-plugin-istanbul": "^7.0.0",
		"vitest": "^3.2.3"
	}
}
