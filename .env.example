# Supabase
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=tu-anon-key
# Solo fuera del navegador: en la web la vuelta del login es siempre al dominio actual
VITE_AUTH_REDIRECT_URL=https://webwiz.orpira.es
VITE_MOBILE_AUTH_REDIRECT_URL=webwizquiz://auth/callback

# Cloudflare Turnstile: obligatoria si Supabase tiene activada la protección CAPTCHA
# (solo la site key pública; la secret key se configura en Supabase)
VITE_TURNSTILE_SITE_KEY=tu-turnstile-site-key
